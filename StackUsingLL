#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

struct Node *top = NULL;
int count = 0;

int size()
{
    return count;
}

int is_empty()
{
    return top == NULL;
}

void push(int value)
{
    struct Node *newNode;

    newNode = (struct Node *)malloc(sizeof(struct Node));

    if (newNode == NULL)
    {
        printf("Stack Overflow\n");
        return;
    }

    newNode->data = value;
    newNode->next = top;
    top = newNode;

    count++;

    printf("%d pushed into stack\n", value);
}

void topElement()
{
    if (is_empty())
    {
        printf("Stack is empty\n");
        return;
    }

    printf("Top element = %d\n", top->data);
}

void pop()
{
    struct Node *temp;
    int value;

    if (is_empty())
    {
        printf("Stack Underflow\n");
        return;
    }

    temp = top;
    value = top->data;

    top = top->next;

    free(temp);

    count--;

    printf("%d popped from stack\n", value);
}

int main()
{
    int choice, value;

    while (1)
    {
        printf("\n----- STACK MENU -----\n");
        printf("1. Size\n");
        printf("2. Is Empty\n");
        printf("3. Push\n");
        printf("4. Top\n");
        printf("5. Pop\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                printf("Size = %d\n", size());
                break;

            case 2:
                if (is_empty())
                    printf("Stack is empty\n");
                else
                    printf("Stack is not empty\n");
                break;

            case 3:
                printf("Enter value: ");
                scanf("%d", &value);
                push(value);
                break;

            case 4:
                topElement();
                break;

            case 5:
                pop();
                break;

            case 6:
                printf("Program terminated\n");
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
